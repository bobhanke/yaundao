.page {
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
  background-color: #f6f6f6;
}

.page-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #111;
  margin-bottom: 10rpx;
}

.page-desc {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 30rpx;
}

.field {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 24rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background-color: #f7f7f7;
  border-radius: 10rpx;
  font-size: 30rpx;
}

.textarea {
  width: 100%;
  height: 180rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background-color: #f7f7f7;
  border-radius: 10rpx;
  font-size: 30rpx;
}

.submit-btn {
  margin-top: 20rpx;
  background-color: #07c160;
  color: #ffffff;
  border-radius: 12rpx;
}
