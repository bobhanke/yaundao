.page {
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
  background-color: #f6f6f6;
}

.page-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #111;
  margin-bottom: 10rpx;
}

.page-desc {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 30rpx;
}

.group {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.group-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #111;
}

.group-count {
  font-size: 26rpx;
  color: #07c160;
}

.group-intro {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.group-foot {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag {
  font-size: 22rpx;
  color: #07c160;
  background-color: rgba(7, 193, 96, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.tag-joined {
  color: #576b95;
  background-color: rgba(87, 107, 149, 0.1);
}

.join-btn {
  background-color: #07c160;
  color: #ffffff;
  border-radius: 30rpx;
  padding: 0 36rpx;
  font-size: 28rpx;
}

.join-btn.is-joined {
  background-color: #dddddd;
  color: #888888;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}

.tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bbbbbb;
}
