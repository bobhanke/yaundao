<view class="page">
  <view class="page-title">加入小组</view>
  <view class="page-desc">挑一个感兴趣的小组，点「加入」就能进去</view>

  <view class="empty" wx:if="{{!loading && groups.length === 0}}">
    暂时还没有小组，下拉可以刷新
  </view>

  <view class="group" wx:for="{{groups}}" wx:key="_id" data-id="{{item._id}}" bindtap="onDetail">
    <view class="group-head">
      <view class="group-name">{{item.name}}</view>
      <view class="group-count">{{item.memberCount}} 人</view>
    </view>

    <view class="group-intro">{{item.intro}}</view>

    <view class="group-foot">
      <view class="tag" wx:if="{{item.owner}}">我创建的</view>
      <view class="tag tag-joined" wx:elif="{{item.joined}}">已加入</view>
      <button
        class="join-btn {{item.joined ? 'is-joined' : ''}}"
        size="mini"
        disabled="{{item.joined}}"
        data-index="{{index}}"
        catchtap="onJoin"
      >{{item.joined ? "已加入" : "加入"}}</button>
    </view>
  </view>

</view>
