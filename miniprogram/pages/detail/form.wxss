.page {
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
  background-color: #f6f6f6;
}

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.name {
  font-size: 40rpx;
  font-weight: 600;
  color: #111;
}

.meta {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.count {
  font-size: 28rpx;
  color: #07c160;
  margin-right: 24rpx;
}

.limit {
  font-size: 26rpx;
  color: #999;
}

.intro {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.section-title {
  font-size: 28rpx;
  color: #888;
  margin-bottom: 20rpx;
}

.member {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.member:last-child {
  border-bottom: none;
}

.member-name {
  font-size: 30rpx;
  color: #333;
}

.member-tags {
  display: flex;
  align-items: center;
}

.tag {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #07c160;
  background-color: rgba(7, 193, 96, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.tag-me {
  color: #576b95;
  background-color: rgba(87, 107, 149, 0.1);
}

.member-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #bbb;
}

.action-btn {
  margin-top: 20rpx;
  background-color: #07c160;
  color: #ffffff;
  border-radius: 12rpx;
}

.action-btn.leave {
  background-color: #ffffff;
  color: #e64340;
  border: 1rpx solid #e64340;
}

.owner-tip {
  margin-top: 30rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

.loading {
  padding: 200rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}
