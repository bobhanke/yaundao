.container {
  background-color: #f1f1f1;
  text-align:center;
  padding: 80rpx;
}

.logos {
    width: 160rpx;
    height: 160rpx;
}

.title{
    font-weight: 500;
    color: #000;
    font-size: 44rpx;
    margin: 50rpx 32rpx;

}

.body {
  min-height: 100vh;
  padding: 30rpx;
  background-color: #ffffff;
  box-sizing: border-box;
}

.section {
  margin-bottom: 30rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background-color: #f7f7f7;
  border-radius: 10rpx;
  font-size: 30rpx;
}

.textarea {
  height: 200rpx;
  padding: 20rpx;
}

.mg {
  display: flex;
  align-items: center;
}

.mg label {
  margin-right: 40rpx;
  font-size: 30rpx;
}

.picker {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  background-color: #f7f7f7;
  border-radius: 10rpx;
  font-size: 30rpx;
}

.submit-btn {
  margin-top: 40rpx;
  background-color: #07c160;
  color: #ffffff;
  border-radius: 10rpx;
}
